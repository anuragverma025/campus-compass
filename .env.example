# Campus Compass — Environment Configuration Template
# Copy this file to .env for local development:
#   cp .env.example .env (or copy .env.example .env in PowerShell)

# Application Branding & Metadata
VITE_APP_NAME="Campus Compass"
VITE_APP_TAGLINE="The Student Life Assistant"
VITE_APP_VERSION="0.1.0-alpha"
VITE_APP_ENV="development"

# Local Storage Key Namespace
VITE_STORAGE_PREFIX="campus_compass_"

# Academic & Timetable Defaults
VITE_MAX_COURSES="8"
VITE_DEFAULT_SEMESTER="Fall 2026"

# Feature Flags
VITE_ENABLE_MOCK_DATA="true"
VITE_ENABLE_ANALYTICS="false"

# External Public API Endpoints
VITE_PUBLIC_API_BASE_URL=""
